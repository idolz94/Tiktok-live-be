{
  "name": "lumi-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API riêng cho Lumi client Next.js: Neon/Drizzle, Clerk, Redis, Worker, Payment, License.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "gn:index": "gitnexus analyze --skip-agents-md",
    "gn:index:force": "gitnexus analyze --force --skip-agents-md",
    "gn:setup": "gitnexus setup",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/express": "^2.1.23",
    "@neondatabase/serverless": "^1.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.19.20",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "tiktok-live-connector": "^2.1.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2"
  }
}
